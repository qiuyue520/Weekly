---
import { SITE, BASE } from '@/config';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
import LangSwitcher from '../LangSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const { blogPage } = SITE;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class='flex-grow text-right flex items-center justify-end gap-4'>
  <HeaderLink href={blogPage} target='_blank' class='hidden md:inline-flex' title="xiaonai's blog">{t('nav.home')}</HeaderLink>
  <HeaderLink href={`${BASE}/${lang}/rss.xml`} target='_blank' class='hidden md:inline-flex' title='RSS'>RSS</HeaderLink>

  <Search />
  <LangSwitcher switchLabel={t('lang.switch')} />
</div>
